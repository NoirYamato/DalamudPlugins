<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MitCue.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- Fight data, timelines, action knowledge base and bundled plans ship inside the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\**\*" Exclude="..\..\data\**\*.md" LogicalName="MitCue.data/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\plans\**\*.yaml" LogicalName="MitCue.plans/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MitCue.Core.Tests" />
  </ItemGroup>

</Project>
