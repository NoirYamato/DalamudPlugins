<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the plugin (src/MitCue): runtime logic (sessions, overlay model, own-use detection, settings, plan
    store) without the game. The plugin targets net10.0-windows and needs the Dalamud assemblies to build, found the
    same way Dalamud.NET.Sdk finds them: $(DALAMUD_HOME), else the XIVLauncher dev folder of the OS. They are copied
    next to the tests (Private=true) so plugin types that implement Dalamud interfaces (Configuration) and stand-ins
    for Dalamud services (DispatchProxy) load; nothing here calls into the game.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <DalamudLibPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
    <DalamudLibPath Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.xlcore/dalamud/Hooks/dev/</DalamudLibPath>
    <DalamudLibPath Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/XIV on Mac/dalamud/Hooks/dev/</DalamudLibPath>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' != ''">$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MitCue.Core\MitCue.Core.csproj" />
    <ProjectReference Include="..\..\src\MitCue\MitCue.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)Dalamud.dll" Private="true" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)Dalamud.Bindings.ImGui.dll" Private="true" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudLibPath)FFXIVClientStructs.dll" Private="true" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudLibPath)InteropGenerator.Runtime.dll" Private="true" />
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)Lumina.dll" Private="true" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)Lumina.Excel.dll" Private="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$(DalamudLibPath)Newtonsoft.Json.dll" Private="true" />
  </ItemGroup>

  <Target Name="EnsureDalamudLibPathExists" BeforeTargets="BeforeBuild">
    <Error Text="MitCue.Plugin.Tests: Dalamud not found at $(DalamudLibPath). Set DALAMUD_HOME to the folder that holds Dalamud.dll." Condition="!Exists('$(DalamudLibPath)Dalamud.dll')" />
  </Target>

</Project>
